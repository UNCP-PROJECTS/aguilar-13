}

% ==============================================================================
% SISTEMA COMPACTO Y ELEGANTE DE TÍTULOS Y SUBTÍTULOS
% ==============================================================================
\titleformat{\section}
    {\color{uncpnavy}\normalfont\large\bfseries}
    {\color{uncpgreen}\rule[-1pt]{3pt}{12pt}\hspace{6pt}\thesection.}{0.4em}{}
    [\vspace{-0.3em}\color{uncpborder}\rule{\textwidth}{0.8pt}\vspace{-0.4em}]

\titleformat{\subsection}
    {\color{uncpnavy}\normalfont\normalsize\bfseries}
    {\color{uncpgold}\thesubsection}{0.5em}{}

\titleformat{\subsubsection}
    {\color{uncpgrey}\normalfont\small\bfseries}
    {\thesubsubsection}{0.5em}{}

\titlespacing*{\section}{0pt}{1.3em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.3em}

% ==============================================================================
% CONFIGURACIÓN DE LISTINGS PARA CÓDIGO FUENTE
% ==============================================================================
\lstdefinestyle{uncpcode}{
    language=Python,
    basicstyle=\ttfamily\footnotesize\color{uncpdark},
    backgroundcolor=\color{uncplight},
    keywordstyle=\color{uncpnavy}\bfseries,
    stringstyle=\color{uncpgreen},
    commentstyle=\color{uncpgrey}\itshape,
    identifierstyle=\color{uncpdark},
    numberstyle=\tiny\color{uncpgrey},
    numbers=none,
    frame=single,
    rulecolor=\color{uncpborder},
    breaklines=true,
    breakatwhitespace=true,
    tabsize=2,
    showstringspaces=false,
    captionpos=b,
    xleftmargin=6pt,
    xrightmargin=6pt,
    framexleftmargin=4pt,
    framexrightmargin=4pt,
    framextopmargin=4pt,
    framexbottommargin=4pt
}

% Macro para marco de captura sin overfull hbox ni desbordamiento vertical
\newcommand{\uncpimagebox}[1]{%
    \fboxsep=0pt\fboxrule=0.6pt\relax%
    \fcolorbox{uncpborder}{white}{\includegraphics[width=\dimexpr\linewidth-1.2pt\relax, height=0.75\textheight, keepaspectratio]{#1}}%
}

% ==============================================================================
% CAJAS DE INFORMACIÓN Y ALERTAS (TCOLORBOX)
% ==============================================================================
\tcbuselibrary{skins}

\newtcolorbox{uncpcard}[2][]{
    enhanced,
    colback=uncplight,
    colframe=uncpnavy,
    colbacktitle=uncpnavy,
    coltitle=white,
    fonttitle=\bfseries\small,
    title=#2,
    arc=3pt,
    boxrule=0.8pt,
    leftrule=4pt,
    titlerule=0pt,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    #1
}

\newtcolorbox{uncpnote}[2][]{
    enhanced,
    colback=uncplight,
    colframe=uncpgreen,
    colbacktitle=uncpgreen,
    coltitle=white,
    fonttitle=\bfseries\small,
    title=#2,
    arc=3pt,
    boxrule=0.8pt,
    leftrule=4pt,
    titlerule=0pt,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    #1
}

% ==============================================================================
% CABECERA COMPACTA DE INFORME INDIVIDUAL
% ==============================================================================
\newcommand{\makeheaderuncp}[5]{
    \begin{center}
        \vspace*{-0.5cm}
        {\color{uncpgreen}\hrule height 2pt}\vspace{0.15cm}
        {\large\bfseries\color{uncpnavy} #1}\\[0.2cm]
        {\normalsize\color{uncpgrey} #2}\\[0.35cm]
        {\color{uncpgold}\hrule height 1pt}\vspace{0.35cm}

        \begin{tcolorbox}[
            colback=uncplight,
            colframe=uncpborder,
            boxrule=0.8pt,
            arc=3pt,
            left=10pt, right=10pt, top=7pt, bottom=7pt
        ]
            \small
            \begin{tabularx}{\textwidth}{@{}l X l X@{}}
                \textbf{\color{uncpnavy}Asignatura:} & #3 & \textbf{\color{uncpnavy}Fecha:} & 25 de noviembre de 2026 \\
                \addlinespace[2pt]
                \textbf{\color{uncpnavy}Estudiante:} & \multicolumn{3}{X}{\textbf{#4}} \\
                \addlinespace[2pt]
                \textbf{\color{uncpnavy}Docente Titular:} & \multicolumn{3}{X}{\textbf{#5}} \\
            \end{tabularx}
        \end{tcolorbox}
    \end{center}
    \vspace{0.2cm}
}
