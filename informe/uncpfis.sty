% ==============================================================================
% PALETA DE COLORES INSTITUCIONALES UNCP & FIS
% ==============================================================================
\definecolor{uncpgreen}{RGB}{0, 104, 55}      % Verde Institucional UNCP (#006837)
\definecolor{uncpgold}{RGB}{194, 110, 0}      % Ámbar / Dorado (#C26E00)
\definecolor{uncpnavy}{RGB}{12, 35, 64}       % Azul Marino FIS (#0C2340)
\definecolor{uncpblue}{RGB}{2, 132, 199}      % Azul Tech (#0284C7)
\definecolor{uncplight}{RGB}{248, 250, 252}   % Fondo Gris Suave (#F8FAFC)
\definecolor{uncpborder}{RGB}{226, 232, 240}  % Borde Neutro (#E2E8F0)
\definecolor{uncpgrey}{RGB}{100, 116, 139}    % Gris Texto Secundario (#64748B)
\definecolor{uncpdark}{RGB}{15, 23, 42}       % Texto Principal (#0F172A)
\definecolor{uncpred}{RGB}{185, 28, 28}       % Alerta / Peligro (#B91C1C)

% ==============================================================================
% CONFIGURACIÓN DE HYPERREF
% ==============================================================================
\hypersetup{
